// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String?   @unique @db.Citext
  phoneNumber     String?   @unique
  firstName       String?
  lastName        String?
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  status          String    @default("active") // 'active' | 'pending' | 'locked' | 'disabled'
  tokenVersion    Int       @default(1)
  createdAt       DateTime  @default(now()) @db.Timestamptz
  updatedAt       DateTime  @updatedAt @db.Timestamptz

  // Relations for multi-tenant RBAC
  userRoles                  UserRole[]
  refreshTokens              RefreshToken[]
  auditLogs                  AuditLog[]
  createdTotTemplates        TotTemplate[]              @relation("TotTemplateCreator")
  updatedTotTemplates        TotTemplate[]              @relation("TotTemplateUpdater")
  createdTotTemplateVersions TotTemplateVersion[]       @relation("TotTemplateVersionCreator")
  createdBrands              Brand[]                    @relation("BrandCreator")
  updatedBrands               Brand[]                    @relation("BrandUpdater")
  createdCategories           Category[]                 @relation("CategoryCreator")
  updatedCategories           Category[]                 @relation("CategoryUpdater")
  createdProducts            Product[]                   @relation("ProductCreator")
  updatedProducts            Product[]                   @relation("ProductUpdater")

  // Ensure at least one contact method exists
  @@index([email])
  @@index([phoneNumber])
  @@map("users")
}

model OtpToken {
  id           String    @id @default(cuid())
  contact      String // Email or phone number (normalized)
  contactType  String // 'email' | 'phone'
  tokenHash    String // Hashed OTP (HMAC-SHA256)
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  ipHash       String?
  uaHash       String?
  status       String    @default("pending") // 'pending' | 'verified' | 'failed' | 'expired'
  failedReason String?
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([contact, contactType])
  @@index([expiresAt])
  @@index([status])
  @@map("otp_tokens")
}

model Configuration {
  id          String   @id @default(cuid())
  key         String   @unique // e.g., "otp.length"
  value       String // Stored as JSON string
  type        String // 'number' | 'string' | 'boolean' | 'json'
  description String?
  category    String // 'otp' | 'rate_limit' | 'security' | 'feature' | 'contact'
  isActive    Boolean  @default(true)
  updatedBy   String? // User ID who updated
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([key])
  @@index([category])
  @@map("configurations")
}

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  code      String?  @unique
  status    String   @default("active") // 'active' | 'suspended' | 'deleted'
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Relations
  roles          Role[]          // Tenant-specific roles
  userRoles      UserRole[]
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  totTemplates   TotTemplate[]
  brands         Brand[]
  categories     Category[]
  products       Product[]

  @@index([name])
  @@index([code])
  @@index([status])
  @@map("tenants")
}

model Role {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String // Unique per tenant (composite unique with tenantId)
  name        String
  tenantId    String?  @db.Uuid // null for global roles, set for tenant-specific roles (scope derived from this)
  description String?
  createdBy   String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  // Relations
  tenant          Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([slug, tenantId]) // Composite unique: slug unique per tenant (null tenantId = global)
  @@index([slug])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module      String // e.g., 'tenant', 'user', 'role', 'catalog'
  action      String // e.g., 'create', 'view', 'edit', 'delete'
  slug        String   @unique // 'tenant:create', 'catalog:upload', etc.
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  // Relations
  rolePermissions RolePermission[]

  @@index([module])
  @@index([action])
  @@index([slug])
  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  tenantId  String?  @db.Uuid // null for global roles
  status    String   @default("active") // 'active' | 'pending' | 'revoked'
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Relations
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, roleId, tenantId])
  @@map("user_roles")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash Bytes // Hashed refresh token
  tenantId  String?   @db.Uuid // null for global-admin context
  userAgent String?
  ip        String?   @db.Inet
  createdAt DateTime  @default(now()) @db.Timestamptz
  expiresAt DateTime  @db.Timestamptz
  revokedAt DateTime? @db.Timestamptz

  // Relations
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("refresh_tokens")
}

model PolicyMeta {
  id        String   @id @default("policy")
  policyVer Int      @default(1)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz

  @@map("policy_meta")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  ts          DateTime @default(now()) @db.Timestamptz
  actorUserId String?  @db.Uuid
  tenantId    String?  @db.Uuid
  action      String // 'tenant.create', 'user.invite', 'catalog.upload', etc.
  resource    String?
  beforeJson  Json?
  afterJson   Json?
  ip          String?  @db.Inet
  userAgent   String?

  // Relations
  actor  User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([actorUserId])
  @@index([ts])
  @@index([action])
  @@map("audit_logs")
}

// TOT Template Enums
enum TotTemplateStatus {
  draft
  active
  archived
}

enum TotTemplateType {
  VOLUME_BASED
  SEASONAL
  LAUNCH_SUPPORT
  CLEARANCE
}

enum TotTemplateParameterType {
  text
  number
  date
  boolean
  currency
  percentage
}

// TOT Template Models
model TotTemplate {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String                  @db.Uuid
  name        String
  description String?
  type        TotTemplateType
  status      TotTemplateStatus       @default(draft)
  content     String                  // HTML content (can include {{parameterName}} placeholders)
  version     String                  @default("v1.0")
  createdBy   String                  @db.Uuid
  updatedBy   String?                 @db.Uuid
  createdAt   DateTime                @default(now()) @db.Timestamptz
  updatedAt   DateTime                @updatedAt @db.Timestamptz

  // Relations
  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator    User                    @relation("TotTemplateCreator", fields: [createdBy], references: [id])
  updater    User?                   @relation("TotTemplateUpdater", fields: [updatedBy], references: [id])
  parameters TotTemplateParameter[]
  versions   TotTemplateVersion[]

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, status])
  @@index([tenantId, name])
  @@map("tot_templates")
}

model TotTemplateParameter {
  id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId  String                  @db.Uuid
  name        String
  type        TotTemplateParameterType
  label       String?
  description String?
  required    Boolean                 @default(false)
  defaultValue String?
  order       Int                     @default(0)
  createdAt   DateTime                @default(now()) @db.Timestamptz
  updatedAt   DateTime                @updatedAt @db.Timestamptz

  // Relations
  template TotTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, name])
  @@index([templateId])
  @@map("tot_template_parameters")
}

model TotTemplateVersion {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId  String            @db.Uuid
  version     String
  content     String
  parameters  Json
  status      TotTemplateStatus
  createdBy   String            @db.Uuid
  createdAt   DateTime          @default(now()) @db.Timestamptz
  changeNotes String?

  // Relations
  template TotTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  creator  User        @relation("TotTemplateVersionCreator", fields: [createdBy], references: [id])

  @@index([templateId])
  @@index([templateId, version])
  @@map("tot_template_versions")
}

// ============================================
// Master Data Models
// ============================================

model Brand {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid
  name        String   // e.g., "Apple", "Samsung"
  code        String   // e.g., "APL", "SAM" - Short code for the brand
  description String?  // Full company name or description
  status      String   @default("active") // 'active' | 'archived'
  createdBy   String   @db.Uuid
  updatedBy   String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  // Relations
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator   User      @relation("BrandCreator", fields: [createdBy], references: [id])
  updater   User?     @relation("BrandUpdater", fields: [updatedBy], references: [id])
  products  Product[]

  // Constraints
  @@unique([tenantId, name])  // Brand name must be unique per tenant
  @@unique([tenantId, code])  // Brand code must be unique per tenant (but same code can exist in different tenants)
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, name])   // For search
  @@map("brands")
}

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid
  name        String   // e.g., "Smartphones", "Tablets"
  code        String   // e.g., "SP", "TAB" - Short code for the category
  description String?  // Category description
  status      String   @default("active") // 'active' | 'archived'
  createdBy   String   @db.Uuid
  updatedBy   String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  // Relations
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creator   User      @relation("CategoryCreator", fields: [createdBy], references: [id])
  updater   User?     @relation("CategoryUpdater", fields: [updatedBy], references: [id])
  products  Product[]

  // Constraints
  @@unique([tenantId, name])  // Category name must be unique per tenant
  @@unique([tenantId, code])  // Category code must be unique per tenant
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, name])   // For search
  @@map("categories")
}

model Product {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid
  name        String   // e.g., "iPhone 15", "Galaxy S23"
  code        String   // e.g., "IP15", "GS23" - Product SKU/code
  description String?  // Product description
  brandId     String   @db.Uuid  // Reference to Brand
  categoryId  String   @db.Uuid  // Reference to Category
  price       Decimal? @db.Decimal(12, 2) // Product price
  status      String   @default("active") // 'active' | 'archived'
  createdBy   String   @db.Uuid
  updatedBy   String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @updatedAt @db.Timestamptz

  // Relations
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand     Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator   User      @relation("ProductCreator", fields: [createdBy], references: [id])
  updater   User?     @relation("ProductUpdater", fields: [updatedBy], references: [id])

  // Constraints
  @@unique([tenantId, name])  // Product name must be unique per tenant
  @@unique([tenantId, code])   // Product code must be unique per tenant
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, brandId])
  @@index([tenantId, categoryId])
  @@index([tenantId, name])   // For search
  @@map("products")
}
