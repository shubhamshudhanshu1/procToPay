{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Docker App",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "address": "localhost",
      "localRoot": "${workspaceFolder}/src",
      "remoteRoot": "/app/src",
      "protocol": "inspector",
      "restart": true
    },
    {
      "name": "Debug Local App",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/src/server.ts",
      "env": {
        "NODE_ENV": "development",
        "DATABASE_URL": "postgresql://postgres:password@localhost:5433/proctopay_dev",
        "REDIS_URL": "redis://localhost:6379",
        "SESSION_SECRET": "dev-session-secret-key-change-in-production",
        "APP_URL": "https://app.localhost:3000",
        "API_URL": "https://api.localhost:4000",
        "MAIL_FROM": "noreply@example.com",
        "AUTH_MODE": "otp",
        "OTP_LENGTH": "6",
        "OTP_TTL_SECONDS": "600",
        "PORT": "4000"
      },
      "runtimeArgs": ["-r", "ts-node/register"],
      "console": "integratedTerminal",
      "restart": true,
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
